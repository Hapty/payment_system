MSSQL_SA_PASSWORD=YourStrong!Passw0rd
RABBITMQ_PASSWORD=YourRabbit!Passw0rd

# Notification (Gmail SMTP). SMTP_USER: gönderen Gmail adresi. SMTP_PASSWORD: Google hesabından alınan
# 16 haneli uygulama şifresi (hesap şifresi değil; https://myaccount.google.com/apppasswords, 2 adımlı doğrulama açık olmalı).
SMTP_USER=
SMTP_PASSWORD=
# Opsiyonel: SMTP_HOST (smtp.gmail.com), SMTP_PORT (587), SMTP_FROM (boşsa SMTP_USER)
