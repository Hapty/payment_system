@host = http://localhost:5001

### BankAccount
GET {{host}}/api/bank-accounts

###
POST {{host}}/api/bank-accounts
Content-Type: application/json

{ "accountNo": "TR000000000000000000000001", "accountStatus": "Active", "balance": 1000.00 }

###
PUT {{host}}/api/bank-accounts/TR000000000000000000000001
Content-Type: application/json

{ "accountNo": "TR000000000000000000000001", "accountStatus": "Blocked" }

###
DELETE {{host}}/api/bank-accounts/TR000000000000000000000001

### Card
GET {{host}}/api/cards

###
GET {{host}}/api/cards/by-number/4111111111111111

###
POST {{host}}/api/cards
Content-Type: application/json

{
  "cardNumber": "4111111111111111",
  "accountNo": "TR000000000000000000000001",
  "cardType": "Debit",
  "expiryDate": "1228",
  "cvv": "123",
  "contactlessAllowed": true,
  "contactlessLimit": 750.00
}

### TransactionType (Otc-Ots)
GET {{host}}/api/transaction-types

###
GET {{host}}/api/transaction-types/10/11

###
POST {{host}}/api/transaction-types
Content-Type: application/json

{ "otc": "20", "ots": "11", "name": "Refund" }

### MtiProcessingCode (Mti-F3)
GET {{host}}/api/mti-processing-codes

###
GET {{host}}/api/mti-processing-codes/0200/000000

###
PUT {{host}}/api/mti-processing-codes/0200/000000
Content-Type: application/json

{ "mti": "0200", "f3_ProcessingCode": "000000", "otc": "10", "ots": "11" }
