{
  "ConnectionStrings": {
    "PaymentSystem": "Server=localhost,1433;Database=PaymentSystem;User Id=sa;TrustServerCertificate=True",
    "RabbitMq": "amqp://payment@localhost:5672"
  },
  "ExchangeRates": {
    "TcmbUrl": "https://www.tcmb.gov.tr/kurlar/today.xml",
    "RefreshMinutes": 60,
    "RetryMinutes": 1,
    "MaxAgeHours": 24
  },
  "Parameters": {
    "RefreshMinutes": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "Topic": "payment.transaction-events",
    "MessageTimeoutMs": 30000
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
