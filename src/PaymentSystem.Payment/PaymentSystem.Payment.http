@host = http://localhost:5002

### ---------- BankAccount ----------
GET {{host}}/api/bank-accounts

###
POST {{host}}/api/bank-accounts
Content-Type: application/json

{ "accountNo": "TR01", "accountStatus": "Active", "balance": 1000.00 }

###
GET {{host}}/api/bank-accounts/TR01

###
# Bakiye değişmez, sadece durum güncellenir
PUT {{host}}/api/bank-accounts/TR01
Content-Type: application/json

{ "accountNo": "TR01", "accountStatus": "Blocked", "balance": 999999 }

###
DELETE {{host}}/api/bank-accounts/TR01

### ---------- Card ----------
GET {{host}}/api/cards

###
POST {{host}}/api/cards
Content-Type: application/json

{
  "cardNumber": "4111111111111111",
  "accountNo": "TR01",
  "cardType": "Debit",
  "expiryDate": "1228",
  "contactlessAllowed": true,
  "contactlessLimit": 750.00
}

###
GET {{host}}/api/cards/by-number/4111111111111111

###
PUT {{host}}/api/cards/1
Content-Type: application/json

{
  "cardNumber": "4111111111111111",
  "accountNo": "TR01",
  "cardType": "Credit",
  "expiryDate": "1229",
  "contactlessAllowed": false
}

###
DELETE {{host}}/api/cards/1

### ---------- TransactionType (Otc/Ots) ----------
GET {{host}}/api/transaction-types

###
GET {{host}}/api/transaction-types/10/11

###
POST {{host}}/api/transaction-types
Content-Type: application/json

{ "otc": "20", "ots": "11", "name": "Refund" }

###
PUT {{host}}/api/transaction-types/20/11
Content-Type: application/json

{ "otc": "20", "ots": "11", "name": "Return" }

###
DELETE {{host}}/api/transaction-types/20/11

### ---------- MtiProcessingCode (MTI + F3) ----------
GET {{host}}/api/mti-processing-codes

###
GET {{host}}/api/mti-processing-codes/0200/000000

###
POST {{host}}/api/mti-processing-codes
Content-Type: application/json

{ "mti": "0200", "f3_ProcessingCode": "200000", "otc": "20", "ots": "11" }

###
PUT {{host}}/api/mti-processing-codes/0200/200000
Content-Type: application/json

{ "mti": "0200", "f3_ProcessingCode": "200000", "otc": "10", "ots": "11" }

###
DELETE {{host}}/api/mti-processing-codes/0200/200000

### ---------- ExchangeRates (kur cache'i, salt okunur) ----------
GET {{host}}/api/exchange-rates

###
# Sayısal (840) ya da harf (USD) kod; cache'te yoksa 404
GET {{host}}/api/exchange-rates/USD

### ---------- Transactions (Gate'in çağırdığı işlem akışı) ----------
# Önce TR01 hesabını ve 4111111111111111 kartını yukarıdaki isteklerle oluştur.
# Aynı isteği (MTI + kart + işlem kodu + tutar + localDate + localTime) ikinci kez gönderirsen para tekrar düşmez, ilk cevap döner.
POST {{host}}/api/transactions
Content-Type: application/json

{
  "mti": "0200",
  "cardNumber": "4111111111111111",
  "processingCode": "000000",
  "amountMinor": 15000,
  "currencyCode": "949",
  "transmissionDateTime": "0315095959",
  "stan": "000001",
  "localTime": "125959",
  "localDate": "0315",
  "terminalId": "TERM0001",
  "cardExpiry": "2812",
  "entryMode": "051"
}

###
# Döviz satışı: 10,00 USD (840). Kur cache'teki TCMB döviz satış kuru; TL karşılığı bakiyeden düşer ve LocalTxnAmount'a yazılır.
# Payment açıldıktan sonra kurlar henüz çekilmediyse (ya da TCMB'ye ulaşılamıyorsa) cevap 91 olur.
POST {{host}}/api/transactions
Content-Type: application/json

{
  "mti": "0200",
  "cardNumber": "4111111111111111",
  "processingCode": "000000",
  "amountMinor": 1000,
  "currencyCode": "840",
  "transmissionDateTime": "0315100000",
  "stan": "000002",
  "localTime": "130000",
  "localDate": "0315",
  "terminalId": "TERM0001",
  "cardExpiry": "2812",
  "entryMode": "051"
}
