### E-ticaret satışı (F22 812): kart fiziksel olarak yok, CVV2 zorunlu (yanlış ya da eksikse F39 N7).
# cvv: kart oluşturulurken POST /api/cards cevabında dönen değer (tırnak içinde).
POST {{gate}}/api/transactions
Content-Type: application/json

{
  "mti": "0200",
  "F2": "4111111111111111",
  "F3": "000000",
  "F4": 2500,
  "F49": "949",
  "F7": "1016100200",
  "F11": "000004",
  "F12": "130200",
  "F13": "20261016",
  "F41": "TERM0001",
  "F42": "TRENDYOL       ",
  "F18": "5399",
  "F43": "TRENDYOL                 ISTANBUL     TR",
  "F14": "2812",
  "F22": "812",
  "cvv": "123"
}

### Kredi kartıyla 6 taksitli satış: 1.200,00 TL. Tutarın tamamı kartın limitinden bir kerede düşer, hesaba dokunulmaz.
# installmentCount: 1-36, yoksa tek çekim. Debit kartla 1'den büyük taksit F39 57 alır.
POST {{gate}}/api/transactions
Content-Type: application/json

{
  "mti": "0200",
  "F2": "4111111111111129",
  "F3": "000000",
  "F4": 120000,
  "F49": "949",
  "F7": "1016100250",
  "F11": "000020",
  "F12": "130250",
  "F13": "20261016",
  "F41": "TERM0001",
  "F42": "TRENDYOL       ",
  "F18": "5399",
  "F43": "TRENDYOL                 ISTANBUL     TR",
  "F14": "2812",
  "F22": "051",
  "installmentCount": 6
}

